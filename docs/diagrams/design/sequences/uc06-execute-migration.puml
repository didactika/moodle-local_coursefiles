@startuml
!include ../../_style.puml
title UC06 - Execute a reviewed migration
actor Administrator
participant migration_executor as Executor
participant "Moodle task / locks" as Core
participant target_binding as Target
participant folder_destination as Folder
database "Run / operations / provenance" as DB
Administrator -> Executor : queue(planid, digest)
Executor -> Core : Plan/profile lock, maintenance and actor task
Core -> Executor : execute(runid)
loop At most 25 included pending files
  Executor -> Core : Destination lock
  Executor -> Executor : Live source, identity and policy checks
  alt Reviewed missing destination
    Executor -> Target : resolve reviewed target key
    Target -> Core : add_moduleinfo or reuse created binding
    Target --> Executor : Verified native folder snapshot
  end
  Executor -> Executor : Check current target path and bytes
  alt Copy or explicitly approved overwrite
    Executor -> Folder : copy(source, target, overwrite)
    Folder -> Core : Native draft and folder update
    Folder --> Executor : Verified stored file
  else Identical / stale / forbidden
    Executor -> Executor : Skip or block
  end
  Executor -> DB : Outcome / original declarations
  Executor -> Core : Release locks
end
Executor --> Core : Next slice or final state
@enduml
