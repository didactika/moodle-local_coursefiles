@startuml
!include ../../_style.puml
title Hourly bounded history expiration
participant clean_history as Task
participant retention as Cleanup
participant "Moodle plan lock" as Lock
participant profile_history as Versions
database "Plugin history" as DB
Task -> Cleanup : clean(now)
Cleanup -> DB : Delete up to 1000 expired logs
Cleanup -> DB : Select up to 100 expired inactive plans
loop Each candidate
  Cleanup -> Lock : Lock plan
  Cleanup -> DB : Recheck age and current attempts
  alt Expired and inactive
    Cleanup -> DB : Transaction: targets, operations, runs, plan
  else Active or recently modified
    Cleanup -> Cleanup : Retain plan
  end
  Cleanup -> Lock : Release
end
Cleanup -> Versions : clean(now)
Versions -> DB : Select up to 100 expired unreferenced versions
Versions -> DB : Recheck under profile lock / remove obsolete metadata
Cleanup --> Task : Deleted log / plan / version counts
note over Cleanup, DB : Native files and author history are retained.
note over Versions, DB : Current and migration-referenced versions remain.
@enduml
