@startuml
!include ../../_style.puml
title UC07 — Cancel or resume pending operations
actor Administrator
participant "Migration report" as UI
participant migration_executor as Executor
database "Run / operation" as DB
Administrator -> UI : Cancel current run or resume pending work
alt cancel
  UI -> Executor : cancel(runid)
  Executor -> DB : cancelled = 1
  Executor -> DB : Observe flag at operation boundary
else resume
  UI -> Executor : queue(planid, reviewed digest)
  Executor -> DB : Create new accountable run
  Executor -> DB : Revalidate and address pending operations
end
DB --> UI : Recorded attempt / preserved copies
@enduml
