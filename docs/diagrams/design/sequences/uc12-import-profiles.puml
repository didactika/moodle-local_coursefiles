@startuml
!include ../../_style.puml
title UC12 - Atomic portable profile import
actor "Profile manager" as Actor
participant profile_import_form as Form
participant profile_bundle as Bundle
participant profiles as Profiles
database "Profiles / revisions / log" as DB
Actor -> Form : Submit native JSON upload
Form -> Form : Check actor draft / file size
Form -> Bundle : documents(json)
Bundle -> Bundle : Validate complete bundle
alt every document valid
  Form -> Bundle : import(json)
  Bundle -> DB : Begin transaction
  loop each configuration
    Bundle -> Profiles : save(json) with new identity
    Profiles -> DB : Activate validated revision / log
  end
  Bundle -> DB : Commit all profiles
  Bundle --> Form : New profile IDs
  Form --> Actor : Redirect / imported count
else invalid document
  Bundle --> Form : Validation error
  Form --> Actor : Native field error
end
@enduml
