@startuml
!include ../_style.puml
title Design - native material browser
left to right direction
class native_filemanager {
 + register_native(hook)
 + toHtml()
}
class native_editor {
 + toHtml()
}
class browser_controller {
 + input(raw)
 + data(token, input)
}
class browser_listing {
 + page(scope, state)
}
class draft_scope {
 + open(element, context)
 + open_contract(contract, context)
 + review(token, profile, items, sesskey)
 + approved(token, digest, sesskey)
 + apply(token, digest, sesskey)
}
class draft_import {
 + review(...)
 + apply(...)
}
class material_selection {
 + resolve(course, profile, items)
 + map_paths(files, items, mode)
}
native_filemanager --> draft_scope
native_editor --> draft_scope
browser_controller --> draft_scope
browser_controller --> browser_listing
draft_scope --> draft_import
draft_import --> material_selection
native_filemanager -[hidden]down-> native_editor
native_editor -[hidden]down-> browser_controller
@enduml
