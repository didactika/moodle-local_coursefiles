@startuml
!include ../_style.puml
title Stored reviewed intent and run attempts
left to right direction
hide methods
entity "local_coursebridge_plan" as plan {
  * id
  uuid / profileid / revisionid
  userid / timecreated
  configjson / digest / state
}

entity "local_coursebridge_operation" as operation {
  * id
  planid / opkey
  sourcehash / targetcmid
  snapshot / decision
  state / result / timemodified
}

entity "local_coursebridge_run" as run {
  * id
  planid / userid
  state / cancelled
  timecreated / timemodified
}

plan ||--o{ operation
plan ||--o{ run
operation -[hidden]down-> run
note bottom of plan : The reviewed JSON and digest do not change during execution.
@enduml
