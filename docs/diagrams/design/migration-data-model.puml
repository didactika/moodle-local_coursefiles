@startuml
!include ../_style.puml
title Stored reviewed intent and run attempts
left to right direction
hide methods
entity "local_multipicker_plan" as plan {
  * id
  uuid / profileid / revisionid
  userid / timecreated
  configjson / digest / state
}

entity "local_multipicker_operation" as operation {
  * id
  planid / opkey
  sourcehash / targetcmid
  sourcecourseid / targetcourseid / sourcecmid
  snapshot / decision / included
  state / result / timemodified
}

entity "local_multipicker_run" as run {
  * id
  planid / userid
  state / cancelled
  timecreated / timemodified
}

entity "local_multipicker_target" as target {
  * id
  planid / targetkey
  definitionjson / cmid / snapshotjson
}

plan ||--o{ target
plan ||--o{ operation
plan ||--o{ run
operation -[hidden]down-> run
note bottom of plan : The reviewed JSON and digest do not change during execution.
@enduml
