@startuml
!include ../_style.puml
title Design - administration pages
top to bottom direction
rectangle "Permission-aware tabs" as Tabs
rectangle "Settings\nPolicy / retention" as Settings
rectangle "Profiles\nTable / state actions / import-export" as Profiles
rectangle "Migration history\nPaged status table" as Migration
rectangle "Reports: material reuse\nAction / reference / date filters" as Log
rectangle "Guided profile form\nAdvanced JSON retained" as Editor
rectangle "Paged review\nSearch / persistent inclusions" as Review
rectangle "Execution screen\nConfirm / background / progress" as Execute
Tabs --> Settings
Tabs --> Profiles
Tabs --> Migration
Tabs --> Log
Profiles --> Editor
rectangle "New migration\nCaptures / folder correspondences" as Wizard
Migration --> Wizard
Wizard --> Review
Review --> Execute
@enduml
