@startuml
!include ../_style.puml
title Supported operator goals
left to right direction
actor Teacher
actor "Publisher / policy manager" as Manager
actor Administrator
rectangle "Teacher reuse" as Reuse {
  usecase "UC01 Search" as Search
  usecase "UC02 Attach" as Attach
}
rectangle "Course governance" as Governance {
  usecase "UC04 Publish / revoke" as Publish
  usecase "UC09 Author policy" as Policy
}
rectangle "Administration" as Admin {
  usecase "UC03 Activate profile" as Profile
  usecase "UC05 Preview" as Preview
  usecase "UC06 Execute" as Execute
  usecase "UC07 Cancel / resume" as Resume
}
Teacher --> Search
Teacher --> Attach
Manager --> Publish
Manager --> Policy
Administrator --> Profile
Administrator --> Preview
Administrator --> Execute
Administrator --> Resume
Reuse -[hidden]down-> Governance
Governance -[hidden]down-> Admin
@enduml
