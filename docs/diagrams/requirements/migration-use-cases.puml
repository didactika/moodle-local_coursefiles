@startuml
!include ../_style.puml
title Reviewed administration
left to right direction
actor Administrator
rectangle "MultiPicker administration" {
  usecase "UC03 Activate profile" as Profile
  usecase "UC05 Preview migration" as Preview
  usecase "UC06 Execute reviewed digest" as Execute
  usecase "UC07 Cancel / resume pending work" as Resume
}
Administrator --> Profile
Administrator --> Preview
Administrator --> Execute
Administrator --> Resume
Profile -[hidden]down-> Preview
Preview -[hidden]down-> Execute
Execute -[hidden]down-> Resume
@enduml
