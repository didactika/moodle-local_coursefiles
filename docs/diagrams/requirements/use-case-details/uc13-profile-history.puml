@startuml
!include ../../_style.puml
title UC13 - One profile, retained configurations
top to bottom direction
state "1. Open version history\nProfile manager" as Open
state "2. Select two version checkboxes\nPaginated history" as Choose
state "3. Compare changed fields\nEscaped side-by-side values" as Compare
state "4. Request historical restoration\nProfile manager" as Restore
state "5. Check session, capability and ownership\nNative controller / profile_history" as Check
state "6. Activate existing version under profile lock\nOriginal number, author and date" as Save
state "7. Confirm / queue catalogue refresh\nNative history page" as Result
state "Refused\nExisting configuration retained" as Refused
[*] --> Open
Open --> Choose
Choose --> Compare
Compare --> Restore
Restore --> Check
Check --> Save : authorized historical configuration
Check -right-> Refused : invalid ownership / access
Save --> Result
Result --> [*]
Refused --> [*]
@enduml
