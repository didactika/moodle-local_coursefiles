@startuml
!include ../../_style.puml
title Effective native-copy author policy
start
:Read source provenance;
:Read site and source/target course policies;
if (Any effective lock?) then (yes)
  :Refuse native copying;
  stop
else (no)
  if (Missing author and block_reuse?) then (yes)
    :Refuse undeclared material;
    stop
  else (no)
    :Capture original declaration;
    :Copy with source author / licence;
    stop
  endif
endif
@enduml
