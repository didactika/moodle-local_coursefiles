@startuml
!include ../../_style.puml
title Course and folder matching
start
:Resolve family and capture filters;
if (Unique source / target pair?) then (yes)
  :Match each source folder correspondence;
  if (Source exists?) then (yes)
    :Resolve reviewed destination section;
    if (Exactly one target folder?) then (yes)
      :Use existing native target;
    else (no)
      if (Missing and explicit creation allowed?) then (yes)
        :Store concrete creation descriptor;
      else (no)
        :Record placement blocker;
        stop
      endif
    endif
    :Compare path and bytes;
    :Store copy / skip / overwrite / blocker;
  else (no)
    :Report missing source without creating it;
  endif
else (no)
  :Record ambiguous pair blocker;
endif
stop
@enduml
