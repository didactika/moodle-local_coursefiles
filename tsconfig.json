{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@moodle/lms/core/ajax": ["js/shims/ajax.ts"],
      "@moodle/lms/core/amd": ["js/shims/amd.ts"]
    }
  },
  "include": ["js/src/**/*.ts", "js/src/**/*.tsx", "js/shims/**/*.ts"]
}
