{
  "schema_version": 1,
  "status": "development-preset",
  "name": "UUID course families with optional annual editions",
  "scope": {"campus": "current", "category_ids": []},
  "relationship": {
    "ambiguity_policy": "block",
    "parsers": [{
      "name": "uuid-code-optional-year",
      "field": "idnumber",
      "pattern": "~^(?<family>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\\|\\|(?<code>[^|]+)(?:\\|\\|(?<edition>\\d{4}))?$~u",
      "required_captures": ["family", "code"],
      "normalizers": {"family": ["trim", "lowercase"], "code": ["trim"]}
    }],
    "family_key": "${family}",
    "display_label": "${code}",
    "edition": {"capture": "edition", "optional": true, "comparison": "string"},
    "pair_dimensions": []
  },
  "publication": {
    "mode": "source-access-only",
    "allowed_sources": ["mod_folder/content", "mod_resource/content"],
    "allow_hidden": false,
    "allow_restricted": false
  },
  "migration": {
    "source_edition": "2025",
    "target_edition": "2026",
    "source_module": {"type": "folder", "field": "name", "equals": "materiales_de_clase.module"},
    "target_module": {"type": "folder", "field": "name", "equals": "materiales_de_clase.module"},
    "section_match": {"strategy": "ordinal", "require_layout_review": true},
    "missing_target": "block",
    "ambiguous_target": "block",
    "same_path_same_content": "skip",
    "same_path_different_content": "block",
    "same_content_different_path": "skip-and-report",
    "preserve_relative_paths": true,
    "preserve_source": true,
    "preserve_target_visibility": true,
    "on_item_failure": "continue-unaffected"
  }
}
