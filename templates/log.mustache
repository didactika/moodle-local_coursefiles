{{!
    @template local_coursebridge/log
    Filtered site action log. Record values are escaped; details are not displayed.
    Example context (json): {"formurl":"/local/coursebridge/log.php","records":[],"hasrecords":false}
}}
<section class="coursebridge-log mb-4">
    <h2>{{#str}}log, local_coursebridge{{/str}}</h2>
    <p class="text-muted">{{#str}}logintro, local_coursebridge{{/str}}</p>
    <form method="get" action="{{formurl}}" class="mb-4">
        <div class="row">
            <div class="col-md-5 mb-3">
                <label for="coursebridge-log-action">{{#str}}logaction, local_coursebridge{{/str}}</label>
                <select id="coursebridge-log-action" name="action" class="form-control">
                    <option value="">{{#str}}logallactions, local_coursebridge{{/str}}</option>
                    {{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}
                </select>
            </div>
            <div class="col-md-7 mb-3">
                <label for="coursebridge-log-reference">{{#str}}logreference, local_coursebridge{{/str}}</label>
                <input id="coursebridge-log-reference" name="entityuuid" value="{{entityuuid}}" maxlength="36" class="form-control">
            </div>
        </div>
        <button class="btn btn-primary" type="submit">{{#str}}filter{{/str}}</button>
        <a class="btn btn-outline-secondary" href="{{clearurl}}">{{#str}}clear, core{{/str}}</a>
    </form>
    {{#hasrecords}}<div class="table-responsive"><table class="table table-striped">
        <thead><tr>
            <th scope="col">{{#str}}date, core{{/str}}</th>
            <th scope="col">{{#str}}logaction, local_coursebridge{{/str}}</th>
            <th scope="col">{{#str}}user, core{{/str}}</th>
            <th scope="col">{{#str}}logreference, local_coursebridge{{/str}}</th>
        </tr></thead>
        <tbody>{{#records}}<tr>
            <td>{{date}}</td><td>{{action}}</td><td>{{user}}</td><td class="text-break">{{reference}}</td>
        </tr>{{/records}}</tbody>
    </table></div>{{/hasrecords}}
    {{^hasrecords}}<p>{{#str}}logempty, local_coursebridge{{/str}}</p>{{/hasrecords}}
    {{#nexturl}}<a class="btn btn-outline-secondary" href="{{nexturl}}">{{#str}}logolder, local_coursebridge{{/str}}</a>{{/nexturl}}
</section>

