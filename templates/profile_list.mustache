{{!
    @template local_coursebridge/profile_list
    Named profile list with active status and revision.
    Context: profiles, hasprofiles, newprofileurl.
    Example context (json): {"profiles":[],"hasprofiles":false}
}}
<section class="coursebridge-profiles mb-4">
    <h2>{{#str}}profiles, local_coursebridge{{/str}}</h2>
    <p class="text-muted">{{#str}}profilesintro, local_coursebridge{{/str}}</p>
    {{#hasprofiles}}<div class="table-responsive"><table class="table table-striped">
        <thead><tr>
            <th scope="col">{{#str}}name, core{{/str}}</th>
            <th scope="col">{{#str}}state, local_coursebridge{{/str}}</th>
            <th scope="col">{{#str}}revision, local_coursebridge{{/str}}</th>
        </tr></thead>
        <tbody>{{#profiles}}<tr>
            <td><a href="{{url}}">{{name}}</a></td><td>{{status}}</td><td>{{revision}}</td>
        </tr>{{/profiles}}</tbody>
    </table></div>{{/hasprofiles}}
    <a class="btn btn-outline-secondary" href="{{newprofileurl}}">{{#str}}newprofile, local_coursebridge{{/str}}</a>
</section>
