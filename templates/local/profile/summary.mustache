{{!
    @template local_coursebridge/local/profile/summary
    Escaped descriptions of the exact reviewed profile revision.
    Example context (json): {"name":"Annual courses","rows":[],"parsers":[],"familykey":"family","editioncapture":"edition"}
}}
<div class="card mb-4" data-region="coursebridge-profile-summary">
    <div class="card-body">
        <h3 class="h5">{{#str}}rulesinuse, local_coursebridge{{/str}}</h3>
        <p>{{name}}{{#revision}} · {{#str}}revision, local_coursebridge{{/str}} {{revision}}{{/revision}}</p>
        {{#editurl}}<p><a href="{{editurl}}">{{#str}}editprofilerules, local_coursebridge{{/str}}</a></p>{{/editurl}}
        <dl class="row mb-0">{{#rows}}
            <dt class="col-md-4">{{label}}</dt><dd class="col-md-8 text-break">{{value}}</dd>
        {{/rows}}</dl>
        <details class="mt-3">
            <summary>{{#str}}relationshiprules, local_coursebridge{{/str}}</summary>
            <p class="mt-3">{{#str}}familykey, local_coursebridge{{/str}}: <code>{{familykey}}</code><br>
                {{#str}}editioncapture, local_coursebridge{{/str}}: <code>{{editioncapture}}</code></p>
            {{#parsers}}<p>{{field}}<br><code class="text-break">{{pattern}}</code></p>{{/parsers}}
        </details>
    </div>
</div>
