    @template local_filebank/local/profile/history
    Paged history and field comparison within a single profile.
    Example context (json): {"versions":[],"choices":[],"rows":[],"profileid":1,"action":"/local/filebank/admin/profile_history.php","backurl":"/local/filebank/admin/profiles.php"}
}}
<section class="filebank-ui filebank-admin" data-filebank-history>
    <header class="fbm-header">
        <div class="fbm-header-title">
            <a href="{{backurl}}" class="btn btn-link btn-sm p-0 fbm-back filebank-back">{{#pix}}t/left, core{{/pix}} {{#str}}back, core{{/str}}</a>
            <div class="fbm-header-line"><h2 class="h2">{{#str}}versionhistory, local_filebank{{/str}}: {{{name}}}</h2></div>
            <p class="text-muted fbm-header-subtitle">{{#str}}versionhistoryhelp, local_filebank{{/str}} {{{historyhelp}}}</p>
        </div>
    </header>
    <form id="filebank-compare" method="get" action="{{action}}" class="fbm-toolbar">
        <input type="hidden" name="profileid" value="{{profileid}}">
        <input type="hidden" name="left" value="0"><input type="hidden" name="right" value="0">
        <label class="fbm-checkline"><input type="checkbox" class="fbm-check" name="changesonly" value="1" {{#changesonly}}checked{{/changesonly}}> {{#str}}changesonly, local_filebank{{/str}}</label>
        <button class="btn btn-primary">{{#pix}}i/search, core{{/pix}}{{#str}}compareversions, local_filebank{{/str}}</button>
        {{#offpagechoices}}<label class="fbm-checkline small"><input type="checkbox" class="fbm-check" data-filebank-version value="{{id}}" checked> {{#str}}version, core{{/str}} {{number}}</label>{{/offpagechoices}}
    </form>
    {{#comparing}}<div class="table-responsive fbm-compare"><table class="table table-hover filebank-version-diff"><thead><tr><th>{{#str}}configfield, local_filebank{{/str}}</th><th>{{#str}}version, core{{/str}} {{leftnumber}}</th><th>{{#str}}version, core{{/str}} {{rightnumber}}</th></tr></thead><tbody>{{#rows}}<tr {{#changed}}class="is-changed"{{/changed}}><th>{{field}}</th><td><code>{{before}}</code></td><td><code>{{after}}</code></td></tr>{{/rows}}</tbody></table></div>{{/comparing}}
    <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="table-responsive"><table class="table table-hover"><thead><tr><th class="fbm-col-check"><span class="filebank-visually-hidden">{{#str}}select, core{{/str}}</span></th><th>{{#str}}version, core{{/str}}</th><th>{{#str}}date, core{{/str}}</th><th>{{#str}}status, core{{/str}}</th><th class="fbm-col-actions"><span class="filebank-visually-hidden">{{#str}}actions, core{{/str}}</span></th></tr></thead><tbody>
        {{#versions}}<tr {{#active}}class="is-active"{{/active}}><td class="fbm-col-check"><input type="checkbox" class="fbm-check" data-filebank-version value="{{id}}" {{#selected}}checked{{/selected}} aria-label="{{#str}}version, core{{/str}} {{number}}"></td><td><strong>{{number}}</strong></td><td class="text-muted">{{date}}</td><td>{{#active}}<span class="badge rounded-pill tone-success">{{#str}}active, core{{/str}}</span>{{/active}}</td><td class="fbm-col-actions"><div class="fbm-actions"><a href="{{compareurl}}" class="btn btn-link btn-icon" title="{{#str}}compareversions, local_filebank{{/str}}" aria-label="{{#str}}compareversions, local_filebank{{/str}}">{{#pix}}i/search, core{{/pix}}</a>{{^active}}<button name="restore" value="{{id}}" class="btn btn-link btn-icon" title="{{#str}}restoreversion, local_filebank{{/str}}" aria-label="{{#str}}restoreversion, local_filebank{{/str}}">{{#pix}}i/restore, core{{/pix}}</button>{{/active}}</div></td></tr>{{/versions}}
        </tbody></table></div>
    </form>
    {{{pagination}}}
</section>
