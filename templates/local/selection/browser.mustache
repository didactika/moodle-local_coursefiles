    @template local_coursefiles/local/selection/browser
    Native embedded browser with automatic filters and selectable grid/list cards.
    Example context (json): {"action":"#","scope":"example","sesskey":"example","cards":[],"count":0,"layout":"grid"}
}}
<form method="post" action="{{action}}" class="coursefiles-browser p-3" data-layout="{{layout}}" data-contextid="{{contextid}}" data-selectioncapacity="{{selectioncapacity}}" data-folderstates="{{folderstates}}" data-selected-content="{{selectedcontent}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="scope" value="{{scope}}">
    <input type="hidden" name="layout" value="{{layout}}">
    {{^multipleprofiles}}<input type="hidden" name="profileid" value="{{profileid}}">{{/multipleprofiles}}
    {{#selecteditems}}<input type="hidden" name="items[]" value="{{value}}">{{/selecteditems}}
    <div class="coursefiles-heading d-flex align-items-center justify-content-between flex-wrap mb-2"><h2 class="h4 mb-0">{{{repositoryname}}}</h2>
        <span class="small text-muted" role="status" data-coursefiles-loading></span>
    </div>
    {{#locked}}<div class="alert alert-warning" role="status">{{#str}}browserlocked, local_coursefiles{{/str}}</div>{{/locked}}
    <div class="coursefiles-toolbar coursefiles-browser-filters d-flex align-items-center justify-content-between flex-wrap my-2">
        <div class="coursefiles-search"><label for="mpq" class="small">{{#str}}filenamefilter, local_coursefiles{{/str}}</label> {{{filenamehelp}}}
            <div class="input-group input-group-sm"><span class="input-group-text">{{#pix}}a/search, core{{/pix}}</span>
                <input type="search" name="q" id="mpq" value="{{filters.q}}" class="form-control form-control-sm" data-coursefiles-filter autocomplete="off">
            </div>
        </div>

        <details class="coursefiles-filter-popover" data-coursefiles-options>
            <summary class="btn btn-sm btn-secondary">{{#pix}}i/filter, core{{/pix}}{{#str}}filters, core{{/str}} <span data-coursefiles-filter-count>{{#filtercount}}({{filtercount}}){{/filtercount}}</span></summary>
            <div class="coursefiles-filter-menu"><div class="coursefiles-filterbar">
        <div><label for="mpmodule" class="small">{{#str}}modulefilter, local_coursefiles{{/str}}</label> {{{modulehelp}}}
            <select name="module" id="mpmodule" class="custom-select custom-select-sm" data-coursefiles-filter>{{#modules}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/modules}}</select>
        </div>
        <div><label for="mptype" class="small">{{#str}}filetypefilter, local_coursefiles{{/str}}</label> {{{filetypehelp}}}
            <select name="mimetype" id="mptype" class="custom-select custom-select-sm" data-coursefiles-filter>{{#types}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/types}}</select>
        </div>
            {{#multipleprofiles}}<div><label for="mpprofile" class="small">{{#str}}browserprofile, local_coursefiles{{/str}}</label> {{{profilehelp}}}
                <select name="profileid" id="mpprofile" class="custom-select custom-select-sm" data-coursefiles-filter>{{#profiles}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/profiles}}</select>
            </div>{{/multipleprofiles}}
            <div><label for="mpshortname" class="small">{{#str}}shortnamefilter, local_coursefiles{{/str}}</label> {{{coursehelp}}}<input type="text" name="shortname" id="mpshortname" value="{{filters.shortname}}" class="form-control form-control-sm" data-coursefiles-filter></div>
            <div><label for="mpdestination" class="small">{{#str}}batchdestination, local_coursefiles{{/str}}</label> {{{destinationhelp}}}<select name="destination" id="mpdestination" class="custom-select custom-select-sm">{{#destinations}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/destinations}}</select></div>
            <div><label for="mpmode" class="small">{{#str}}copymode, local_coursefiles{{/str}}</label> {{{modehelp}}}<select name="mode" id="mpmode" class="custom-select custom-select-sm">{{#modes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/modes}}</select></div>
            {{#capturefilters}}<div><label for="{{id}}" class="small">{{{label}}}</label> {{{capturehelp}}}
                <input type="text" name="captures[{{key}}]" id="{{id}}" value="{{value}}" class="form-control form-control-sm" maxlength="255" list="{{id}}-values" data-coursefiles-filter autocomplete="off">
                <datalist id="{{id}}-values">{{#suggestions}}<option value="{{value}}"></option>{{/suggestions}}</datalist>
            </div>{{/capturefilters}}
            {{#morecapturefilters}}<div><label for="{{id}}" class="small">{{{label}}}</label> {{{capturehelp}}}
                <input type="text" name="captures[{{key}}]" id="{{id}}" value="{{value}}" class="form-control form-control-sm" maxlength="255" list="{{id}}-values" data-coursefiles-filter autocomplete="off">
                <datalist id="{{id}}-values">{{#suggestions}}<option value="{{value}}"></option>{{/suggestions}}</datalist>
            </div>{{/morecapturefilters}}

            </div><div class="d-flex justify-content-end border-top mt-2 pt-2">
                <button name="clearfilters" value="1" class="btn btn-sm btn-outline-secondary" data-coursefiles-clear-filters {{^filtercount}}disabled{{/filtercount}}>{{#pix}}i/reload, core{{/pix}} {{#str}}clearfilters, local_coursefiles{{/str}}</button>
            </div></div>
        </details>
    </div>
    <div class="coursefiles-toolbar d-flex align-items-center justify-content-between flex-wrap my-2">
        <div class="d-flex flex-wrap">
            <button name="search" value="1" class="btn btn-sm btn-outline-secondary" data-coursefiles-search>{{#str}}batchsearch, local_coursefiles{{/str}}</button>
            <button name="selectall" value="1" class="btn btn-sm btn-link">{{#str}}selectall, local_coursefiles{{/str}}</button>
            <button name="clear" value="1" class="btn btn-sm btn-link">{{#str}}clearselection, local_coursefiles{{/str}}</button>
        </div>
        <div class="btn-group" role="group" data-coursefiles-layout-region aria-label="{{#str}}browserlayout, local_coursefiles{{/str}}">
            <button type="button" class="btn btn-sm btn-outline-secondary {{#gridlayout}}active{{/gridlayout}}" data-coursefiles-layout="grid" aria-pressed="{{#gridlayout}}true{{/gridlayout}}{{^gridlayout}}false{{/gridlayout}}" title="{{#str}}layoutgrid, local_coursefiles{{/str}}">{{#pix}}a/view_icon_active, core{{/pix}}<span class="coursefiles-visually-hidden">{{#str}}layoutgrid, local_coursefiles{{/str}}</span></button>
            <button type="button" class="btn btn-sm btn-outline-secondary {{#listlayout}}active{{/listlayout}}" data-coursefiles-layout="list" aria-pressed="{{#listlayout}}true{{/listlayout}}{{^listlayout}}false{{/listlayout}}" title="{{#str}}layoutlist, local_coursefiles{{/str}}">{{#pix}}a/view_list_active, core{{/pix}}<span class="coursefiles-visually-hidden">{{#str}}layoutlist, local_coursefiles{{/str}}</span></button>
            <button type="button" class="btn btn-sm btn-outline-secondary {{#treelayout}}active{{/treelayout}}" data-coursefiles-layout="tree" aria-pressed="{{#treelayout}}true{{/treelayout}}{{^treelayout}}false{{/treelayout}}" title="{{#str}}layouttree, local_coursefiles{{/str}}">{{#pix}}a/view_tree_active, core{{/pix}}<span class="coursefiles-visually-hidden">{{#str}}layouttree, local_coursefiles{{/str}}</span></button>
        </div>
    </div>
    {{#infolder}}<div class="coursefiles-toolbar mb-2 d-flex align-items-center justify-content-between flex-wrap my-2"><button name="openfolder" value="{{parent}}" class="btn btn-sm btn-outline-secondary coursefiles-back">{{#pix}}t/left, core{{/pix}} {{#str}}back, core{{/str}}</button><span class="small text-muted text-break">{{{location}}}</span></div>{{/infolder}}
    <div class="coursefiles-results" data-coursefiles-results><div class="coursefiles-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></div><div class="coursefiles-cards">
        {{#treegroups}}<div class="coursefiles-browser-tree-group" data-collapsed="false">
            <button type="button" class="btn btn-sm btn-link coursefiles-course-heading{{^treelayout}} d-none{{/treelayout}}" data-coursefiles-course-toggle {{^treelayout}}hidden{{/treelayout}} aria-expanded="true"><span class="coursefiles-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#pix}}i/course, core{{/pix}} <strong class="text-break">{{{name}}}</strong></button>
            <div class="coursefiles-tree-entries">{{#cards}}{{> local_coursefiles/local/selection/card}}{{/cards}}</div>
        </div>{{/treegroups}}

    </div>
    {{^cards}}<div class="coursefiles-empty text-muted py-4 text-center">{{#pix}}a/search, core{{/pix}}<p class="mt-2">{{#catalogpending}}{{#str}}catalogpending, local_coursefiles{{/str}}{{/catalogpending}}{{^catalogpending}}{{#str}}batchempty, local_coursefiles{{/str}}{{/catalogpending}}</p></div>{{/cards}}
    <div class="coursefiles-pagination mt-3 d-flex align-items-center justify-content-between flex-wrap">
        {{#previouspage}}<button name="previouspage" value="1" class="btn btn-sm btn-outline-secondary">{{#pix}}t/left, core{{/pix}} {{#str}}previous, core{{/str}}</button>{{/previouspage}}
        {{#next}}<button name="next" value="{{next}}" class="btn btn-sm btn-outline-secondary">{{#str}}batchnext, local_coursefiles{{/str}} {{#pix}}t/right, core{{/pix}}</button>{{/next}}
    </div>
    </div><div class="coursefiles-footer d-flex align-items-center justify-content-between flex-wrap mt-2 pt-2 pb-1 border-top">
        <span class="small"><strong data-coursefiles-count>{{count}}</strong> {{#str}}selecteditems, local_coursefiles{{/str}}</span>
        <button name="review" value="1" class="btn btn-primary" data-coursefiles-review>{{#str}}batchreview, local_coursefiles{{/str}} {{#pix}}t/right, core{{/pix}}</button>
    </div>
</form>
