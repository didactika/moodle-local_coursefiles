{{!
    @template local_multipicker/local/selection/browser
    Native embedded browser with automatic filters and selectable grid/list cards.
    Example context (json): {"action":"#","scope":"example","sesskey":"example","cards":[],"count":0,"layout":"grid"}
}}
<form method="post" action="{{action}}" class="multipicker-browser p-3" data-layout="{{layout}}" data-contextid="{{contextid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="scope" value="{{scope}}">
    <input type="hidden" name="layout" value="{{layout}}">
    {{^multipleprofiles}}<input type="hidden" name="profileid" value="{{profileid}}">{{/multipleprofiles}}
    {{#retained}}<input type="hidden" name="items[]" value="{{value}}">{{/retained}}
    <div class="multipicker-heading"><h2 class="h4 mb-0">{{#str}}pluginname, local_multipicker{{/str}}</h2>
        <span class="small text-muted" role="status" data-multipicker-loading></span>
    </div>
    {{#locked}}<div class="alert alert-warning" role="status">{{#str}}browserlocked, local_multipicker{{/str}}</div>{{/locked}}
    <div class="multipicker-filterbar">
        <div class="multipicker-search"><label for="mpq" class="small">{{#str}}filenamefilter, local_multipicker{{/str}}</label>
            <div class="input-group input-group-sm"><span class="input-group-text">{{#pix}}a/search, core{{/pix}}</span>
                <input type="search" name="q" id="mpq" value="{{filters.q}}" class="form-control form-control-sm" data-multipicker-filter autocomplete="off">
            </div>
        </div>
        <div><label for="mpmodule" class="small">{{#str}}modulefilter, local_multipicker{{/str}}</label>
            <select name="module" id="mpmodule" class="form-control form-control-sm" data-multipicker-filter>{{#modules}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/modules}}</select>
        </div>
        <div><label for="mptype" class="small">{{#str}}filetypefilter, local_multipicker{{/str}}</label>
            <select name="mimetype" id="mptype" class="form-control form-control-sm" data-multipicker-filter>{{#types}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/types}}</select>
        </div>
        {{#capturefilters}}<div><label for="{{id}}" class="small">{{{label}}}</label>
            <input type="text" name="captures[{{key}}]" id="{{id}}" value="{{value}}" class="form-control form-control-sm" maxlength="255" list="{{id}}-values" data-multipicker-filter autocomplete="off">
            <datalist id="{{id}}-values">{{#suggestions}}<option value="{{value}}"></option>{{/suggestions}}</datalist>
        </div>{{/capturefilters}}
    </div>
    <details class="multipicker-options mb-3" data-multipicker-options>
        <summary>{{#pix}}i/settings, core{{/pix}} {{#str}}browseroptions, local_multipicker{{/str}}</summary>
        <div class="multipicker-filterbar mt-2">
            {{#morecapturefilters}}<div><label for="{{id}}" class="small">{{{label}}}</label>
                <input type="text" name="captures[{{key}}]" id="{{id}}" value="{{value}}" class="form-control form-control-sm" maxlength="255" list="{{id}}-values" data-multipicker-filter autocomplete="off">
                <datalist id="{{id}}-values">{{#suggestions}}<option value="{{value}}"></option>{{/suggestions}}</datalist>
            </div>{{/morecapturefilters}}
            {{#multipleprofiles}}<div><label for="mpprofile" class="small">{{#str}}browserprofile, local_multipicker{{/str}}</label>
                <select name="profileid" id="mpprofile" class="form-control form-control-sm" data-multipicker-filter>{{#profiles}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/profiles}}</select>
            </div>{{/multipleprofiles}}
            <div><label for="mpshortname" class="small">{{#str}}shortnamefilter, local_multipicker{{/str}}</label><input type="text" name="shortname" id="mpshortname" value="{{filters.shortname}}" class="form-control form-control-sm" data-multipicker-filter></div>
            <div><label for="mpdestination" class="small">{{#str}}batchdestination, local_multipicker{{/str}}</label><select name="destination" id="mpdestination" class="form-control form-control-sm">{{#destinations}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/destinations}}</select></div>
            <div><label for="mpmode" class="small">{{#str}}copymode, local_multipicker{{/str}}</label><select name="mode" id="mpmode" class="form-control form-control-sm">{{#modes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>{{/modes}}</select></div>
        </div>
    </details>
    <div class="multipicker-toolbar">
        <div class="d-flex flex-wrap">
            <button name="search" value="1" class="btn btn-sm btn-outline-secondary" data-multipicker-search>{{#str}}batchsearch, local_multipicker{{/str}}</button>
            <button name="selectpage" value="1" class="btn btn-sm btn-link">{{#str}}selectpage, local_multipicker{{/str}}</button>
            <button name="clear" value="1" class="btn btn-sm btn-link">{{#str}}clearselection, local_multipicker{{/str}}</button>
        </div>
        <div class="btn-group" role="group" aria-label="{{#str}}browserlayout, local_multipicker{{/str}}">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-multipicker-layout="grid" aria-pressed="{{^listlayout}}true{{/listlayout}}{{#listlayout}}false{{/listlayout}}" title="{{#str}}layoutgrid, local_multipicker{{/str}}">{{#pix}}grid, local_multipicker{{/pix}}<span class="multipicker-visually-hidden">{{#str}}layoutgrid, local_multipicker{{/str}}</span></button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-multipicker-layout="list" aria-pressed="{{#listlayout}}true{{/listlayout}}{{^listlayout}}false{{/listlayout}}" title="{{#str}}layoutlist, local_multipicker{{/str}}">{{#pix}}list, local_multipicker{{/pix}}<span class="multipicker-visually-hidden">{{#str}}layoutlist, local_multipicker{{/str}}</span></button>
        </div>
    </div>
    {{#infolder}}<div class="mb-2"><button name="openfolder" value="{{parent}}" class="btn btn-sm btn-outline-secondary multipicker-back">{{#pix}}back, local_multipicker{{/pix}} {{#str}}back, core{{/str}}</button></div>{{/infolder}}
    <div class="multipicker-cards">
        {{#cards}}<div class="card multipicker-card {{#checked}}multipicker-selected{{/checked}}">
            <div class="card-body">
                <input type="checkbox" id="{{id}}" name="items[]" value="{{value}}" {{#checked}}checked{{/checked}}>
                <div class="multipicker-card-content">
                    <label for="{{id}}" class="multipicker-card-title">{{#isfolder}}{{#pix}}f/folder, core{{/pix}}{{/isfolder}}{{^isfolder}}{{#pix}}{{icon}}, core{{/pix}}{{/isfolder}} {{{title}}}</label>
                    <div class="multipicker-origin text-break">{{{origin}}}</div>
                    <div class="multipicker-card-meta"><span class="multipicker-chip">{{#isfolder}}{{#str}}folder, core{{/str}}{{/isfolder}}{{^isfolder}}{{#str}}file, core{{/str}}{{/isfolder}}</span><span class="text-muted text-break">{{details}}</span></div>
                </div>
                {{#isfolder}}<button name="openfolder" value="{{open}}" class="btn btn-outline-secondary multipicker-open" title="{{#str}}openfolder, local_multipicker{{/str}}">{{#pix}}forward, local_multipicker{{/pix}}<span class="multipicker-visually-hidden">{{#str}}openfolder, local_multipicker{{/str}}</span></button>{{/isfolder}}
            </div>
        </div>{{/cards}}
    </div>
    {{^cards}}<div class="multipicker-empty text-muted py-4 text-center">{{#pix}}a/search, core{{/pix}}<p class="mt-2">{{#str}}batchempty, local_multipicker{{/str}}</p></div>{{/cards}}
    <div class="multipicker-pagination mt-3">
        {{#previouspage}}<button name="previouspage" value="1" class="btn btn-sm btn-outline-secondary">{{#pix}}back, local_multipicker{{/pix}} {{#str}}previous, core{{/str}}</button>{{/previouspage}}
        {{#next}}<button name="next" value="{{next}}" class="btn btn-sm btn-outline-secondary">{{#str}}batchnext, local_multipicker{{/str}} {{#pix}}forward, local_multipicker{{/pix}}</button>{{/next}}
    </div>
    <div class="multipicker-footer">
        <span class="small"><strong data-multipicker-count>{{count}}</strong> {{#str}}selecteditems, local_multipicker{{/str}}</span>
        <button name="review" value="1" class="btn btn-primary" data-multipicker-review>{{#str}}batchreview, local_multipicker{{/str}} {{#pix}}forward, local_multipicker{{/pix}}</button>
    </div>
</form>
