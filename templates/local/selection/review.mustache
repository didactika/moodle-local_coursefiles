{{!
    @template local_multipicker/local/selection/review
    Separate embedded review page. Native saving remains on the owning form.
    Example context (json): {"backurl":"#","count":2,"size":"1 KB","nodes":[],"approved":false}
}}
<main class="multipicker-browser multipicker-selection-review p-3">
    <div class="multipicker-heading">
        <a href="{{backurl}}" class="btn btn-outline-secondary multipicker-back">{{#pix}}back, local_multipicker{{/pix}} {{#str}}backtoselection, local_multipicker{{/str}}</a>
        <h2 class="h4 mb-0">{{#str}}batchreview, local_multipicker{{/str}}</h2>
    </div>
    {{#error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/error}}
    {{^error}}<p class="text-muted mt-3">{{#str}}batchresult, local_multipicker{{/str}} {{count}} ({{size}})</p>
    <ul class="multipicker-tree multipicker-tree-root">{{#nodes}}{{> local_multipicker/local/selection/review_node}}{{/nodes}}</ul>
    <div class="multipicker-footer">
        {{#approved}}<button type="button" data-multipicker-confirm disabled class="btn btn-primary">{{#str}}importselection, local_multipicker{{/str}}</button>{{/approved}}
        <span data-multipicker-status role="status" class="small text-muted"></span>
    </div>{{/error}}
</main>
