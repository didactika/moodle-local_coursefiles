{{!
    @template local_coursebridge/local/selection/review

    Native folder batch review.

    Context variables:
    * count - Resulting draft file count.
    * size - Resulting native draft size.
    * rows - Reviewed paths, declarations and readable decisions.

    Example context (json):
    {
        "count": 2,
        "size": "1 KB",
        "rows": [{"filename": "lesson.txt", "filepath": "/", "author": "Teacher", "license": "cc", "decision": "Copy"}]
    }
}}
<div class="coursebridge-selection-review mt-3">
    <h3 class="h5">{{#str}}batchreview, local_coursebridge{{/str}}</h3>
    <p>{{#str}}batchresult, local_coursebridge{{/str}} {{count}} ({{size}})</p>
    <ul class="list-group">
        {{#rows}}
        <li class="list-group-item text-break">
            <div><strong>{{filepath}}{{filename}}</strong> <span class="badge bg-secondary text-white">{{decision}}</span></div>
            <div class="small">{{#str}}author, repository{{/str}}: {{author}} / {{#str}}license, repository{{/str}}: {{license}}</div>
        </li>
        {{/rows}}
    </ul>
</div>
