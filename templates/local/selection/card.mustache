    @template local_multipicker/local/selection/card
    One authorized material node shared by grid, list and course tree layouts.
    Example context (json): {"title":"Notes","isfolder":false,"value":"file:hash","id":"material"}
}}
{{#isfolder}}<div class="multipicker-browser-folder" data-tree-folder="{{value}}">{{/isfolder}}
<div class="card multipicker-card {{#checked}}multipicker-selected{{/checked}}">
            <div class="card-body d-flex align-items-start p-2">
                <input type="checkbox" id="{{id}}" name="choices[]" data-multipicker-choice value="{{value}}" data-contenthash="{{contenthash}}" data-partial="{{partial}}" {{#checked}}checked{{/checked}}>
                <div class="multipicker-card-content">
                    <div class="multipicker-card-kind d-flex align-items-center mb-1">{{#isfolder}}{{#pix}}f/folder, core{{/pix}}{{/isfolder}}{{^isfolder}}{{#pix}}{{icon}}, core{{/pix}}{{/isfolder}} <span class="multipicker-chip">{{#isfolder}}{{#str}}folder, core{{/str}}{{/isfolder}}{{^isfolder}}{{#str}}file, core{{/str}}{{/isfolder}}</span></div>
                    <label for="{{id}}" class="multipicker-card-title" title="{{plaintitle}}">{{{title}}}</label>
                    <div class="multipicker-origin text-break">{{#showorigin}}{{{origin}}}{{/showorigin}}</div>
                    <div class="multipicker-card-meta d-flex flex-wrap mt-2 pt-2 border-top">{{#isfolder}}<span class="multipicker-chip">{{selectionlabel}}</span>{{/isfolder}}{{^isfolder}}<span class="text-muted text-break">{{details}}</span>{{/isfolder}}</div>
                </div>
                {{#isfolder}}<button name="openfolder" value="{{open}}" class="btn btn-outline-secondary multipicker-open" aria-expanded="false" title="{{#str}}openfolder, local_multipicker{{/str}}">{{#pix}}t/right, core{{/pix}}<span class="multipicker-visually-hidden">{{#str}}openfolder, local_multipicker{{/str}}</span></button>{{/isfolder}}
            </div>
        </div>
{{#isfolder}}<div class="multipicker-browser-children" data-tree-entries hidden></div></div>{{/isfolder}}
