    @template local_coursefiles/local/selection/review_node
    Authorized destination tree node.
    Example context (json): {"name":"notes","folder":true,"children":[]}
}}
<li class="coursefiles-tree-node">
    {{#folder}}<details open><summary><input type="checkbox" data-coursefiles-review-folder aria-label="{{name}}"><span class="coursefiles-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#pix}}f/folder, core{{/pix}} <span>{{name}}</span></summary>
        <ul class="coursefiles-tree">{{#children}}{{> local_coursefiles/local/selection/review_node}}{{/children}}</ul>
    </details>{{/folder}}
    {{^folder}}<div class="coursefiles-tree-file">
        <div class="coursefiles-review-row">
            <div class="d-flex align-items-center coursefiles-review-name"><input type="checkbox" name="removefiles[]" value="{{hash}}" aria-label="{{name}}" class="coursefiles-gap-end">{{#pix}}f/document, core{{/pix}}<input type="hidden" name="renames[{{hash}}]" value="{{name}}"><span class="text-break" data-coursefiles-file-name>{{name}}</span><button type="button" class="btn btn-sm btn-link coursefiles-pencil" data-coursefiles-rename aria-label="{{#str}}renamefile, local_coursefiles{{/str}}">{{#pix}}t/edit, core{{/pix}}</button></div>
            <div class="coursefiles-review-actions"><span class="badge {{#blocked}}bg-danger{{/blocked}}{{^blocked}}{{#copy}}bg-success{{/copy}}{{^copy}}bg-secondary{{/copy}}{{/blocked}} text-white">{{decision}}</span><button class="btn btn-sm btn-link text-danger" name="removeitem" value="{{hash}}" aria-label="{{#str}}removeselected, local_coursefiles{{/str}}">{{#pix}}t/delete, core{{/pix}}</button></div>
        </div>
        <div class="small text-muted">{{#str}}author, repository{{/str}}: {{author}} · {{#str}}license, repository{{/str}}: {{license}}</div>
    </div>{{/folder}}
</li>
