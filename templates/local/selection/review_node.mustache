    @template local_filebank/local/selection/review_node
    One folder or file of the review tree.
    Example context (json): {"standalone":true,"name":"notes","folder":true,"children":[]}
}}
{{#standalone}}<ul class="filebank-tree">{{/standalone}}
<li class="filebank-tree-node">
    {{#folder}}<details open><summary><input type="checkbox" data-filebank-review-folder aria-label="{{name}}"><span class="filebank-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#pix}}f/folder, core{{/pix}} <span>{{name}}</span></summary>
        <ul class="filebank-tree">{{#children}}{{> local_filebank/local/selection/review_node}}{{/children}}</ul>
    </details>{{/folder}}
    {{^folder}}<div class="filebank-tree-file">
        <div class="filebank-review-row">
            <div class="d-flex align-items-center filebank-review-name"><input type="checkbox" name="removefiles[]" value="{{hash}}" aria-label="{{name}}" class="filebank-gap-end">{{#pix}}f/document, core{{/pix}}<input type="hidden" name="renames[{{hash}}]" value="{{name}}"><span class="text-break" data-filebank-file-name>{{name}}</span><button type="button" class="btn btn-link btn-icon filebank-pencil" data-filebank-rename aria-label="{{#str}}renamefile, local_filebank{{/str}}">{{#pix}}t/edit, core{{/pix}}</button></div>
            <div class="filebank-review-actions"><span class="badge rounded-pill {{#blocked}}tone-danger{{/blocked}}{{^blocked}}{{#copy}}tone-success{{/copy}}{{^copy}}tone-neutral{{/copy}}{{/blocked}}">{{decision}}</span><button class="btn btn-link btn-icon tone-danger" name="removeitem" value="{{hash}}" aria-label="{{#str}}removeselected, local_filebank{{/str}}">{{#pix}}t/delete, core{{/pix}}</button></div>
        </div>
        <div class="small text-muted">{{#str}}author, repository{{/str}}: {{author}} · {{#str}}license, repository{{/str}}: {{license}}</div>
    </div>{{/folder}}
</li>
{{#standalone}}</ul>{{/standalone}}
