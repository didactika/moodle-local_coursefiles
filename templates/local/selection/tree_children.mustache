{{!
    @template local_multipicker/local/selection/tree_children
    One lazy authorized folder page, including nested collapsed folders and selectable files.
    Example context (json): {"cards":[],"folder":"folder:1:Lw==","next":""}
}}
{{#cards}}{{> local_multipicker/local/selection/card}}{{/cards}}
{{^cards}}<p class="small text-muted m-2">{{#str}}batchempty, local_multipicker{{/str}}</p>{{/cards}}
{{#next}}<button type="button" class="btn btn-sm btn-outline-secondary my-2" data-tree-next="{{next}}" data-tree-parent="{{folder}}">{{#str}}batchnext, local_multipicker{{/str}}{{#pix}}t/right, core{{/pix}}</button>{{/next}}
