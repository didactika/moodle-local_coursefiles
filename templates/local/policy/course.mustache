{{!
    @template local_coursebridge/local/policy/course
    Native course policy form and inherited effective status.
    Context: actionurl, sesskey, courseid, locked, effectivelabel, canoverride, choices, catalogurl.
    Example context (json): {"locked":true,"effectivelabel":"Preserve and lock declared author","choices":[]}
}}
<section class="coursebridge-policy" data-region="coursebridge-policy">
    <h2>{{#str}}coursepolicy, local_coursebridge{{/str}}</h2>
    <p class="text-muted">{{#str}}policyintro, local_coursebridge{{/str}}</p>
    <div class="card mb-4"><div class="card-body">
        <h3 class="h5">{{#str}}effectivepolicy, local_coursebridge{{/str}}</h3>
        <p>{{effectivelabel}}</p>
        {{#locked}}<div class="alert alert-info mb-0">{{#str}}lockedpolicyhelp, local_coursebridge{{/str}}</div>{{/locked}}
        {{^locked}}<p class="text-muted mb-0">{{#str}}editablepolicyhelp, local_coursebridge{{/str}}</p>{{/locked}}
    </div></div>
    {{#canoverride}}<form method="post" action="{{actionurl}}" class="card mb-4"><div class="card-body">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <label for="coursebridgepolicy">{{#str}}author_policy, local_coursebridge{{/str}}</label>
        <select class="form-control mb-3" name="policy" id="coursebridgepolicy">{{#choices}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/choices}}</select>
        <button class="btn btn-primary" type="submit">{{#str}}savechanges, core{{/str}}</button>
    </div></form>{{/canoverride}}
    {{^canoverride}}<p>{{#str}}policymanagedbysite, local_coursebridge{{/str}}</p>{{/canoverride}}
    <a class="btn btn-outline-secondary" href="{{catalogurl}}">{{#str}}backtomaterials, local_coursebridge{{/str}}</a>
</section>
