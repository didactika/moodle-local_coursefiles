    @template local_filebank/local/policy/course
    Effective author policy and, when the site permits it, a stricter course choice.
    Example context (json): {"locked":true,"effectivelabel":"Preserve and lock declared author","choices":[]}
}}
<section class="filebank-ui filebank-policy" data-region="filebank-policy">
    <header class="fbm-header">
        <div class="fbm-header-title">
            <div class="fbm-header-line"><h2 class="h2">{{#str}}coursepolicy, local_filebank{{/str}}</h2></div>
            <p class="text-muted fbm-header-subtitle">{{#str}}policyintro, local_filebank{{/str}}</p>
        </div>
        <div class="fbm-header-actions"><a class="btn btn-outline-secondary" href="{{catalogurl}}">{{#pix}}t/left, core{{/pix}}{{#str}}backtomaterials, local_filebank{{/str}}</a></div>
    </header>
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{#str}}effectivepolicy, local_filebank{{/str}}</h3></div>
        <div class="card-body">
            <p class="fbm-policy-effective"><span class="badge rounded-pill {{#locked}}tone-warning{{/locked}}{{^locked}}tone-success{{/locked}}">{{effectivelabel}}</span></p>
            {{#locked}}<div class="alert alert-info"><div class="fbm-alert-body">{{#str}}lockedpolicyhelp, local_filebank{{/str}}</div></div>{{/locked}}
            {{^locked}}<p class="text-muted">{{#str}}editablepolicyhelp, local_filebank{{/str}}</p>{{/locked}}
        </div>
    </div>
    {{#canoverride}}<form method="post" action="{{actionurl}}" class="card">
        <div class="card-body">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <div class="fbm-field">
                <label for="filebankpolicy" class="form-label">{{#str}}author_policy, local_filebank{{/str}}</label> {{{policyhelp}}}
                <select class="form-select" name="policy" id="filebankpolicy">{{#choices}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/choices}}</select>
            </div>
            <div class="filebank-page-actions fbm-wizard-foot"><button class="btn btn-primary" type="submit">{{#str}}savechanges, core{{/str}}</button></div>
        </div>
    </form>{{/canoverride}}
    {{^canoverride}}<p class="text-muted">{{#str}}policymanagedbysite, local_filebank{{/str}}</p>{{/canoverride}}
</section>
