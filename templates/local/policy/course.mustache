    @template local_coursefiles/local/policy/course
    Native course policy form and inherited effective status.
    Context: actionurl, sesskey, courseid, locked, effectivelabel, canoverride, choices, catalogurl.
    Example context (json): {"locked":true,"effectivelabel":"Preserve and lock declared author","choices":[]}
}}
<section class="coursefiles-policy" data-region="coursefiles-policy">
    <h2>{{#str}}coursepolicy, local_coursefiles{{/str}}</h2>
    <p class="text-muted">{{#str}}policyintro, local_coursefiles{{/str}}</p>
    <div class="card mb-4"><div class="card-body">
        <h3 class="h5">{{#str}}effectivepolicy, local_coursefiles{{/str}}</h3>
        <p>{{effectivelabel}}</p>
        {{#locked}}<div class="alert alert-info mb-0">{{#str}}lockedpolicyhelp, local_coursefiles{{/str}}</div>{{/locked}}
        {{^locked}}<p class="text-muted mb-0">{{#str}}editablepolicyhelp, local_coursefiles{{/str}}</p>{{/locked}}
    </div></div>
    {{#canoverride}}<form method="post" action="{{actionurl}}" class="card mb-4"><div class="card-body">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <label for="coursefilespolicy">{{#str}}author_policy, local_coursefiles{{/str}} </label> {{{policyhelp}}}
        <select class="custom-select custom-select-sm mb-3" name="policy" id="coursefilespolicy">{{#choices}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/choices}}</select>
        <div class="coursefiles-page-actions d-flex align-items-center flex-wrap py-3 mt-3 border-top"><button class="btn btn-primary" type="submit">{{#str}}savechanges, core{{/str}}</button></div>
    </div></form>{{/canoverride}}
    {{^canoverride}}<p>{{#str}}policymanagedbysite, local_coursefiles{{/str}}</p>{{/canoverride}}
    <a class="btn btn-outline-secondary" href="{{catalogurl}}">{{#str}}backtomaterials, local_coursefiles{{/str}}</a>
</section>
