    @template local_filebank/local/migration/list
    Bounded migration history with accessible grouped row and bulk actions.
    Example context (json): {"formurl":"/local/filebank/admin/migration.php","records":[],"states":[],"newurl":"#"}
}}
<section class="filebank-admin filebank-migrations">
    <h2 class="h4">{{#str}}migrations, local_filebank{{/str}}</h2>
    <div class="d-flex justify-content-end mb-3"><details class="filebank-filter-popover"><summary class="btn btn-sm btn-secondary">{{#pix}}i/filter, core{{/pix}} {{#str}}filters, core{{/str}}</summary><form method="get" action="{{formurl}}" class="filebank-filter-menu">
        <input type="hidden" name="perpage" value="{{perpage}}">
        <label for="mpmigrationsearch">{{#str}}profile, local_filebank{{/str}} </label> {{{filterhelp}}}<input type="search" class="form-control form-control-sm mb-3" name="q" id="mpmigrationsearch" value="{{search}}">
        <label for="mpmigrationstate">{{#str}}status, core{{/str}} </label> {{{filterhelp}}}<select class="custom-select custom-select-sm mb-3" name="state" id="mpmigrationstate"><option value="">{{#str}}all, core{{/str}}</option>{{#states}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/states}}</select>
        <div class="filebank-actionbar d-flex align-items-center flex-wrap"><button class="btn btn-sm btn-primary">{{#str}}filter, core{{/str}}</button><a href="{{formurl}}" class="btn btn-sm btn-link">{{#str}}reset, core{{/str}}</a></div>
    </form></details></div>
    <form method="post" action="{{formurl}}" data-filebank-migrations>
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="q" value="{{search}}"><input type="hidden" name="perpage" value="{{perpage}}">
        <div class="filebank-actionbar mb-3 d-flex align-items-center flex-wrap"><a href="{{newurl}}" class="btn btn-sm btn-primary">{{#pix}}t/add, core{{/pix}} {{#str}}newmigration, local_filebank{{/str}}</a><div class="btn-group filebank-row-actions" role="group" aria-label="{{#str}}actions, core{{/str}}" data-filebank-bulk-actions hidden><button name="action" value="delete" class="btn btn-sm btn-outline-danger" disabled title="{{#str}}deleteselectedmigrations, local_filebank{{/str}}" aria-label="{{#str}}deleteselectedmigrations, local_filebank{{/str}}">{{#pix}}t/delete, core{{/pix}}</button></div></div>
        <div class="table-responsive"><table class="table table-hover"><thead><tr><th><input type="checkbox" data-filebank-selectall aria-label="{{#str}}selectall, core{{/str}}"></th><th>{{#str}}profile, local_filebank{{/str}}</th><th>{{#str}}sourcecourses, local_filebank{{/str}}</th><th>{{#str}}targetcourses, local_filebank{{/str}}</th><th>{{#str}}date, core{{/str}}</th><th>{{#str}}status, core{{/str}}</th><th>{{#str}}actions, core{{/str}}</th></tr></thead><tbody>
            {{#records}}<tr><td>{{#candelete}}<input type="checkbox" name="plans[]" value="{{id}}" aria-label="{{#str}}selectmigration, local_filebank{{/str}}">{{/candelete}}</td><td><a href="{{url}}">{{{name}}}</a></td><td class="small">{{source}}</td><td class="small">{{target}}</td><td class="small">{{date}}</td><td><span class="filebank-chip">{{status}}</span></td><td><div class="btn-group filebank-row-actions" role="group" aria-label="{{#str}}actions, core{{/str}}">
                <a href="{{url}}" class="btn btn-sm btn-outline-primary" title="{{#str}}view, core{{/str}}" aria-label="{{#str}}view, core{{/str}}">{{#pix}}i/search, core{{/pix}}</a>
                {{#editurl}}<a href="{{editurl}}" class="btn btn-sm btn-outline-secondary" title="{{#str}}edit, core{{/str}}" aria-label="{{#str}}edit, core{{/str}}">{{#pix}}t/edit, core{{/pix}}</a>{{/editurl}}
                {{#candelete}}<button name="deleteplan" value="{{id}}" class="btn btn-sm btn-outline-danger" title="{{#str}}deletemigration, local_filebank{{/str}}" aria-label="{{#str}}deletemigration, local_filebank{{/str}}">{{#pix}}t/delete, core{{/pix}}</button>{{/candelete}}
            </div></td></tr>{{/records}}
        </tbody></table></div>
        {{^records}}<p class="alert alert-info">{{#str}}nomigrations, local_filebank{{/str}}</p>{{/records}}
        {{{pagination}}}

    </form>
</section>
