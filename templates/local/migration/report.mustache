{{!
    @template local_multipicker/local/migration/report
    Paged, grouped review of the immutable preview and its execution state.
    Example context (json): {"planstate":"Ready for review","metrics":[],"groups":[],"runs":[],"filters":[]}
}}
<section class="multipicker-admin multipicker-migration" data-region="multipicker-migration">
    <h2>{{#str}}report, local_multipicker{{/str}}</h2>
    <ol class="multipicker-steps mb-4" aria-label="{{#str}}migrationsteps, local_multipicker{{/str}}">
        <li><span class="multipicker-step-number">1</span>{{#str}}migrationstep_profile, local_multipicker{{/str}}</li>
        <li><span class="multipicker-step-number">2</span><a href="{{newplanurl}}">{{#str}}migrationstep_scope, local_multipicker{{/str}}</a></li>
        <li {{#reviewstep}}aria-current="step"{{/reviewstep}}><span class="multipicker-step-number">3</span><a href="{{reviewurl}}">{{#str}}migrationstep_review, local_multipicker{{/str}}</a></li>
        <li {{#executionstep}}aria-current="step"{{/executionstep}}><span class="multipicker-step-number">4</span>{{#str}}migrationstep_execute, local_multipicker{{/str}}</li>
    </ol>
    {{#sourceedition}}<p class="h5">{{sourceedition}} → {{targetedition}}</p>{{/sourceedition}}
    <div class="multipicker-toolbar"><a class="btn btn-sm btn-outline-secondary" href="{{newplanurl}}">{{#pix}}t/edit, core{{/pix}}{{#str}}changescope, local_multipicker{{/str}}</a>{{#reviewstep}}{{#canexecute}}<a href="{{executionurl}}" class="btn btn-primary btn-sm">{{#str}}continueexecution, local_multipicker{{/str}}{{#pix}}t/right, core{{/pix}}</a>{{/canexecute}}{{/reviewstep}}</div>
    <p><span class="multipicker-chip">{{planstate}}</span> <span class="small text-muted">{{includedlabel}}</span></p>
    <div class="row mb-3">{{#metrics}}
        <div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body">
            <div class="h3">{{count}}</div><div>{{label}}</div>
        </div></div></div>
    {{/metrics}}</div>
    <details class="mb-4">
        <summary><span class="multipicker-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#str}}reviewedrules, local_multipicker{{/str}}</summary>
        <div class="mt-3">{{#summary}}{{> local_multipicker/local/profile/summary}}{{/summary}}</div>
        <p class="small text-muted text-break">{{#str}}planreference, local_multipicker{{/str}}: {{uuid}}</p>
    </details>
    {{#emptycancelled}}<div class="alert alert-info">{{#str}}emptymigration, local_multipicker{{/str}}</div>{{/emptycancelled}}
    {{#blocked}}<div class="alert alert-warning">{{#str}}blockedpreviewhelp, local_multipicker{{/str}}</div>{{/blocked}}
    {{#hasissues}}<div class="alert alert-warning">
        <h3 class="h5">{{#str}}reviewissues, local_multipicker{{/str}}</h3>
        <ul class="mb-0">{{#issues}}<li>{{description}}{{#context}}<div class="small text-break">{{context}}</div>{{/context}}</li>{{/issues}}</ul>
        <p class="small mt-2">{{issuepageinfo}}</p>
        <nav aria-label="{{#str}}reviewissues, local_multipicker{{/str}}">
            {{#issuepreviousurl}}<a class="btn btn-sm btn-outline-secondary" href="{{issuepreviousurl}}">{{#str}}previous, core{{/str}}</a>{{/issuepreviousurl}}
            {{#issuenexturl}}<a class="btn btn-sm btn-outline-secondary" href="{{issuenexturl}}">{{#str}}next, core{{/str}}</a>{{/issuenexturl}}
        </nav>
    </div>{{/hasissues}}
    {{#reviewstep}}
    <form method="get" action="{{actionurl}}" class="multipicker-panel">
        <input type="hidden" name="planid" value="{{planid}}">
        <input type="hidden" name="issuepage" value="{{issuepage}}">
        <label for="multipicker-migration-q" class="small">{{#str}}migrationsearch, local_multipicker{{/str}}</label>
        <div class="input-group input-group-sm"><input type="search" name="q" id="multipicker-migration-q" value="{{search}}" class="form-control"><button class="btn btn-outline-secondary" type="submit">{{#pix}}a/search, core{{/pix}}{{#str}}search, core{{/str}}</button></div>
    </form>
    <nav class="mb-3" aria-label="{{#str}}decision, local_multipicker{{/str}}">
        <ul class="nav nav-pills flex-wrap">{{#filters}}<li class="nav-item">
            <a href="{{url}}" class="nav-link {{#active}}active{{/active}}" {{#active}}aria-current="page"{{/active}}>{{label}} ({{count}})</a>
        </li>{{/filters}}</ul>
    </nav>
    <p class="small text-muted">{{pageinfo}}</p>
    <form method="post" action="{{actionurl}}" data-multipicker-migration-selection>
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="digest" value="{{digest}}">
        <input type="hidden" name="q" value="{{search}}"><input type="hidden" name="page" value="{{page}}"><input type="hidden" name="decision" value="{{decision}}">
        <input type="hidden" name="issuepage" value="{{issuepage}}">
        {{#selectioneditable}}<div class="multipicker-panel d-flex flex-wrap align-items-center">
            <label class="mb-0 multipicker-gap-end-lg"><input type="checkbox" data-multipicker-selectall> {{#str}}selectpage, local_multipicker{{/str}}</label>
            <div class="btn-group multipicker-row-actions" role="group" aria-label="{{#str}}actions, core{{/str}}">
            <button name="action" value="all" class="btn btn-sm btn-outline-secondary" title="{{#str}}includeall, local_multipicker{{/str}}" aria-label="{{#str}}includeall, local_multipicker{{/str}}">{{#pix}}i/checked, core{{/pix}}</button>
            <button name="action" value="none" class="btn btn-sm btn-outline-secondary" title="{{#str}}excludeall, local_multipicker{{/str}}" aria-label="{{#str}}excludeall, local_multipicker{{/str}}">{{#pix}}i/unchecked, core{{/pix}}</button>
            <button name="action" value="selection" class="btn btn-sm btn-primary" title="{{#str}}saveselection, local_multipicker{{/str}}" aria-label="{{#str}}saveselection, local_multipicker{{/str}}">{{#pix}}e/save, core{{/pix}}</button>
            </div>
        </div>{{/selectioneditable}}
    {{#courses}}<details open class="multipicker-migration-group mb-3" data-multipicker-group>
        <summary><span class="multipicker-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span><span class="text-break">{{#sourcecoursehtml}}{{{sourcecoursehtml}}}{{/sourcecoursehtml}}{{^sourcecoursehtml}}{{sourcecourse}}{{/sourcecoursehtml}} → {{#targetcoursehtml}}{{{targetcoursehtml}}}{{/targetcoursehtml}}{{^targetcoursehtml}}{{targetcourse}}{{/targetcoursehtml}}</span>{{#selectioneditable}}<input type="checkbox" data-multipicker-course="{{groupcourseid}}" data-total="{{coursetotal}}" data-included="{{courseincluded}}" aria-label="{{#str}}selectcourse, local_multipicker{{/str}}" {{#coursechecked}}checked{{/coursechecked}} data-partial="{{coursepartial}}">{{/selectioneditable}}</summary>
        {{#folders}}<details open class="multipicker-migration-folder mt-2"><summary><span class="multipicker-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span><span>{{#sourcefolderhtml}}{{{sourcefolderhtml}}} → {{/sourcefolderhtml}}{{{targetfolderhtml}}}</span>{{#selectioneditable}}<input type="checkbox" data-multipicker-folder="{{groupcmid}}" data-total="{{grouptotal}}" data-included="{{groupincluded}}" data-course="{{groupcourseid}}" aria-label="{{#str}}selectfolder, local_multipicker{{/str}}" {{#groupchecked}}checked{{/groupchecked}} data-partial="{{grouppartial}}">{{/selectioneditable}}</summary>
        <p class="text-muted text-break">{{#targetsectionhtml}}{{{targetsectionhtml}}}{{/targetsectionhtml}}{{^targetsectionhtml}}{{targetsection}}{{/targetsectionhtml}} / {{#targetfolderhtml}}{{{targetfolderhtml}}}{{/targetfolderhtml}}{{^targetfolderhtml}}{{targetfolder}}{{/targetfolderhtml}}</p>
        <ul class="list-group list-group-flush">{{#operations}}<li class="list-group-item px-0">
            <div class="row"><div class="col-md-7">
                {{#selectioneditable}}<input type="hidden" name="visible[]" value="{{id}}"><input type="checkbox" name="included[]" value="{{id}}" data-source-course="{{sourcecourseid}}" data-source-folder="{{sourcecmid}}" {{#included}}checked{{/included}} aria-label="{{filename}}">{{/selectioneditable}}
                <strong class="text-break">{{filename}}</strong>{{^included}} <span class="multipicker-chip">{{#str}}excluded, local_multipicker{{/str}}</span>{{/included}}<div class="small text-muted text-break">{{filepath}}</div>
                <div class="small text-break">{{author}} · {{license}}</div>
            </div><div class="col-md-5 mt-2 mt-md-0">
                <span class="multipicker-chip">{{decisionlabel}}</span><div class="small">{{statelabel}}</div>
                {{#resultlabel}}<div class="small">{{resultlabel}}</div>{{/resultlabel}}
            </div></div>
        </li>{{/operations}}</ul>
    </details>{{/folders}}</details>{{/courses}}
    </form>
    {{^hasoperations}}<p class="alert alert-info">{{#str}}nofilteredoperations, local_multipicker{{/str}}</p>{{/hasoperations}}
    <nav class="mb-4" aria-label="{{#str}}pagination, local_multipicker{{/str}}">
        {{#previousurl}}<a class="btn btn-outline-secondary" href="{{previousurl}}">{{#str}}previous, core{{/str}}</a>{{/previousurl}}
        {{#nexturl}}<a class="btn btn-outline-secondary" href="{{nexturl}}">{{#str}}next, core{{/str}}</a>{{/nexturl}}
    </nav>
    {{/reviewstep}}
    {{#executionstep}}<a href="{{reviewurl}}" class="btn btn-sm btn-outline-secondary mb-3">{{#pix}}t/left, core{{/pix}}{{#str}}backtoreview, local_multipicker{{/str}}</a>
    {{#hasruns}}<section class="mb-4" aria-label="{{#str}}planprogress, local_multipicker{{/str}}">
        <h3 class="h5">{{#str}}planprogress, local_multipicker{{/str}}</h3>
        <p>{{planprogress}}</p>
        <progress class="w-100" value="{{plancompleted}}" max="{{plantotal}}" aria-label="{{planprogress}}"></progress>
        <p><a href="{{refreshurl}}" class="btn btn-outline-secondary">{{#str}}refreshstatus, local_multipicker{{/str}}</a></p>
    </section>{{/hasruns}}
    {{#runs}}<div class="card mb-3"><div class="card-body">
        <h3 class="h5">{{#str}}runreference, local_multipicker, {{id}}{{/str}} · {{statelabel}}</h3>
        {{#cancancel}}<form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="runid" value="{{id}}">
            <button class="btn btn-outline-secondary" name="action" value="cancel" type="submit">{{#str}}cancelrun, local_multipicker{{/str}}</button>
        </form>{{/cancancel}}
    </div></div>{{/runs}}
    {{#canexecute}}<div class="card mb-4"><div class="card-body">
        <h3 class="h5">4. {{#str}}migrationstep_execute, local_multipicker{{/str}}</h3>
        <p>{{#str}}reviewbeforeexecute, local_multipicker{{/str}}</p>
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="digest" value="{{digest}}">
            <label class="d-block mb-3"><input type="checkbox" name="confirmed" value="1" required>
                {{#str}}confirmmigration, local_multipicker{{/str}}</label>
            <button class="btn btn-primary" name="action" value="execute" type="submit">{{#str}}execute, local_multipicker{{/str}}</button>
        </form>
    </div></div>{{/canexecute}}
    {{/executionstep}}

</section>
