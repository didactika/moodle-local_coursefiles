    @template local_coursefiles/local/catalog/index
    Course-scoped material catalog. Labels use component language strings.
    Context: actionurl, courseid, profiles, filters, assets, hasassets, nexturl,
    reseturl, canrefresh, sesskey, publicationenabled, publicationmodules, policyurl.
    Example context (json): {"actionurl":"/local/coursefiles/course/index.php","courseid":2,"profiles":[],"filters":{},"assets":[]}
}}
<section class="coursefiles-admin coursefiles-catalog" data-region="coursefiles-catalog" aria-labelledby="coursefiles-catalog-title">
    <div class="mb-4">
        <h2 id="coursefiles-catalog-title">{{#str}}dashboard, local_coursefiles{{/str}}</h2>
        <p class="text-muted">{{#str}}catalogintro, local_coursefiles{{/str}}</p>
    </div>
    {{#hasprofiles}}
    {{> local_coursefiles/local/catalog/filters}}
    {{#hasassets}}
    <p class="small text-muted">{{#str}}originhelp, local_coursefiles{{/str}}</p>
    {{#assets}}{{> local_coursefiles/local/catalog/material_card}}{{/assets}}
    {{/hasassets}}
    {{^hasassets}}
    <div class="card mb-4" data-region="coursefiles-empty">
        <div class="card-body text-center">
            <h3 class="h5">{{#str}}none, local_coursefiles{{/str}}</h3>
            <p class="text-muted">{{#str}}emptyhelp, local_coursefiles{{/str}}</p>
            <a href="{{reseturl}}" class="btn btn-outline-secondary">{{#str}}clearfilters, local_coursefiles{{/str}}</a>
        </div>
    </div>
    {{/hasassets}}
    {{#nexturl}}<nav class="mb-4" aria-label="{{#str}}pagination, local_coursefiles{{/str}}">
        <a href="{{nexturl}}" class="btn btn-outline-primary">{{#str}}nextpage, local_coursefiles{{/str}}</a>
    </nav>{{/nexturl}}
    {{/hasprofiles}}
    {{^hasprofiles}}<div class="alert alert-info">{{#str}}noprofile, local_coursefiles{{/str}}</div>{{/hasprofiles}}
    {{#canrefresh}}
    <details class="mb-4"><summary><span class="coursefiles-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#str}}catalogmaintenance, local_coursefiles{{/str}}</summary>
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5">{{#str}}catalogmaintenance, local_coursefiles{{/str}}</h3>
            <p class="text-muted">{{#str}}refreshhelp, local_coursefiles{{/str}}</p>
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="courseid" value="{{courseid}}">
                <input type="hidden" name="profileid" value="{{profileid}}">
                <button class="btn btn-outline-secondary" type="submit" name="action" value="refresh">{{#str}}reindex, local_coursefiles{{/str}}</button>
            </form>
        </div>
    </div>
    </details>
    {{/canrefresh}}
    {{#publicationenabled}}<details class="mb-4">
        <summary><span class="coursefiles-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#str}}publicationtitle, local_coursefiles{{/str}}</summary>
        {{> local_coursefiles/local/catalog/publication}}
    </details>{{/publicationenabled}}
</section>
