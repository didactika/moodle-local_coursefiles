    @template local_filebank/local/catalog/index
    Course-scoped material catalog. Labels use component language strings.
    Context: actionurl, courseid, profiles, filters, assets, hasassets, nexturl,
    reseturl, canrefresh, sesskey, publicationenabled, publicationmodules, policyurl.
    Example context (json): {"actionurl":"/local/filebank/course/index.php","courseid":2,"profiles":[],"filters":{},"assets":[]}
}}
<section class="filebank-ui filebank-admin filebank-catalog" data-region="filebank-catalog" aria-labelledby="filebank-catalog-title">
    <header class="fbm-header">
        <div class="fbm-header-title">
            <div class="fbm-header-line"><h2 id="filebank-catalog-title" class="fbm-h2">{{#str}}dashboard, local_filebank{{/str}}</h2></div>
            <p class="fbm-muted fbm-header-subtitle">{{#str}}catalogintro, local_filebank{{/str}}</p>
        </div>
    </header>
    {{#hasprofiles}}
    {{> local_filebank/local/catalog/filters}}
    {{#hasassets}}
    <p class="fbm-small fbm-muted">{{#str}}originhelp, local_filebank{{/str}}</p>
    {{#assets}}{{> local_filebank/local/catalog/material_card}}{{/assets}}
    {{/hasassets}}
    {{^hasassets}}
    <div class="fbm-empty" data-region="filebank-empty">
        <h4 class="fbm-h4">{{#str}}none, local_filebank{{/str}}</h4>
        <p class="fbm-muted fbm-empty-text">{{#str}}emptyhelp, local_filebank{{/str}}</p>
        <div class="fbm-empty-actions"><a href="{{reseturl}}" class="fbm-btn">{{#str}}clearfilters, local_filebank{{/str}}</a></div>
    </div>
    {{/hasassets}}
    {{#nexturl}}<nav class="fbm-listbar" aria-label="{{#str}}pagination, local_filebank{{/str}}">
        <a href="{{nexturl}}" class="fbm-btn fbm-btn-primary">{{#str}}nextpage, local_filebank{{/str}}</a>
    </nav>{{/nexturl}}
    {{/hasprofiles}}
    {{^hasprofiles}}<div class="fbm-alert tone-info"><div class="fbm-alert-body">{{#str}}noprofile, local_filebank{{/str}}</div></div>{{/hasprofiles}}
    {{#canrefresh}}
    <details class="fbm-details">
        <summary><span class="filebank-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#str}}catalogmaintenance, local_filebank{{/str}}</summary>
        <div class="fbm-panel-body">
            <p class="fbm-muted">{{#str}}refreshhelp, local_filebank{{/str}}</p>
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="courseid" value="{{courseid}}">
                <input type="hidden" name="profileid" value="{{profileid}}">
                <button class="fbm-btn" type="submit" name="action" value="refresh">{{#str}}reindex, local_filebank{{/str}}</button>
            </form>
        </div>
    </details>
    {{/canrefresh}}
    {{#publicationenabled}}<details class="fbm-details">
        <summary><span class="filebank-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#str}}publicationtitle, local_filebank{{/str}}</summary>
        {{> local_filebank/local/catalog/publication}}
    </details>{{/publicationenabled}}
</section>
