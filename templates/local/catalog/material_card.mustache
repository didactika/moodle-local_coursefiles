    @template local_filebank/local/catalog/material_card
    One authorized content group with its exact source declarations.
    Context: filename, size, origincount, occurrences.
    Example context (json): {"filename":"slides.pdf","size":"120 KB","origincount":2,"occurrences":[]}
}}
<article class="card filebank-material" data-region="filebank-material">
    <header class="card-header">
        <h3 class="card-title text-break">{{#pix}}i/files, core{{/pix}} {{filename}}</h3>
        <span class="small text-muted">{{size}} · {{#str}}origincount, local_filebank, {{origincount}}{{/str}}</span>
    </header>
    <div class="fbm-panel-flush">
        <div class="table-responsive fbm-flush">
            <table class="table table-hover">
                <caption class="filebank-visually-hidden">{{#str}}originscaption, local_filebank, {{filename}}{{/str}}</caption>
                <thead><tr>
                    <th scope="col">{{#str}}shortnamecourse, core{{/str}}</th>
                    <th scope="col">{{#str}}editionfilter, local_filebank{{/str}}</th>
                    <th scope="col">{{#str}}source, local_filebank{{/str}}</th>
                    <th scope="col">{{#str}}author, core_repository{{/str}}</th>
                </tr></thead>
                <tbody>{{#occurrences}}<tr>
                    <td>{{#courseurl}}<a href="{{courseurl}}">{{{shortname}}}</a>{{/courseurl}}{{^courseurl}}{{{shortname}}}{{/courseurl}}</td>
                    <td>{{editionlabel}}</td>
                    <td>{{{modulename}}}<div class="small text-muted">{{filepath}}</div></td>
                    <td>{{authorlabel}}<div class="small text-muted">{{license}}</div></td>
                </tr>{{/occurrences}}</tbody>
            </table>
        </div>
    </div>
</article>
