    @template local_coursefiles/local/catalog/material_card
    One authorized content group with its exact source declarations.
    Context: filename, size, origincount, occurrences.
    Example context (json): {"filename":"slides.pdf","size":"120 KB","origincount":2,"occurrences":[]}
}}
<article class="card mb-3 coursefiles-material" data-region="coursefiles-material">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between mb-2">
            <h3 class="h5 mb-2 text-break">{{#pix}}i/files, core{{/pix}} {{filename}}</h3>
            <span class="small text-muted">{{size}} · {{#str}}origincount, local_coursefiles, {{origincount}}{{/str}}</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <caption class="coursefiles-visually-hidden">{{#str}}originscaption, local_coursefiles, {{filename}}{{/str}}</caption>
                <thead><tr>
                    <th scope="col">{{#str}}shortnamecourse, core{{/str}}</th>
                    <th scope="col">{{#str}}editionfilter, local_coursefiles{{/str}}</th>
                    <th scope="col">{{#str}}source, local_coursefiles{{/str}}</th>
                    <th scope="col">{{#str}}author, core_repository{{/str}}</th>
                </tr></thead>
                <tbody>{{#occurrences}}<tr>
                    <td>{{#courseurl}}<a href="{{courseurl}}">{{{shortname}}}</a>{{/courseurl}}{{^courseurl}}{{{shortname}}}{{/courseurl}}</td>
                    <td>{{editionlabel}}</td>
                    <td>{{{modulename}}}<div class="small text-muted">{{filepath}}</div></td>
                    <td>{{authorlabel}}<div class="small text-muted">{{license}}</div></td>
                </tr>{{/occurrences}}</tbody>
            </table>
        </div>
    </div>
</article>
