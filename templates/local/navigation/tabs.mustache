{{!
    @template local_coursebridge/local/navigation/tabs
    Permission-filtered links between full pages, without JavaScript panels.
    Example context (json): {"tabs":[{"label":"Settings","url":"#","active":true}]}
}}
<nav class="mb-4" data-region="coursebridge-navigation" aria-label="{{#str}}pluginname, local_coursebridge{{/str}}">
    <ul class="nav nav-tabs flex-wrap">
        {{#tabs}}<li class="nav-item">
            <a class="nav-link {{#active}}active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>{{label}}</a>
        </li>{{/tabs}}
    </ul>
</nav>
