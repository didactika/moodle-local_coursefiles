    @template local_filebank/local/navigation/pagination
    Bounded shared pagination with native controls and preserved search parameters.
    Example context (json): {"id":"mp-page-1","summary":"1–25 / 100","pagelabel":"Page 1 of 4","sizes":[]}
}}
<nav class="filebank-pagination fbm-listbar" aria-label="{{#str}}pagination, local_filebank{{/str}}">
    <div class="fbm-listbar-size">
        <label for="{{id}}" class="fbm-listbar-label">{{#str}}pagesize, local_filebank{{/str}}</label> {{{help}}}
        <select id="{{id}}" class="fbm-select filebank-page-size" data-filebank-pagesize data-url="{{url}}" data-pageparameter="{{pageparameter}}">
            {{#sizes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/sizes}}
        </select>
    </div>
    <div class="fbm-listbar-pages"><span class="fbm-muted fbm-small" aria-live="polite">{{summary}} · {{pagelabel}}</span>
        <div class="fbm-actions" role="group" aria-label="{{#str}}pagination, local_filebank{{/str}}">
            {{#previousurl}}<a href="{{previousurl}}" class="fbm-page" title="{{#str}}previous, core{{/str}}" aria-label="{{#str}}previous, core{{/str}}">{{#pix}}t/left, core{{/pix}}</a>{{/previousurl}}
            {{^previousurl}}<button type="button" class="fbm-page" disabled aria-label="{{#str}}previous, core{{/str}}">{{#pix}}t/left, core{{/pix}}</button>{{/previousurl}}
            {{#nexturl}}<a href="{{nexturl}}" class="fbm-page" title="{{#str}}next, core{{/str}}" aria-label="{{#str}}next, core{{/str}}">{{#pix}}t/right, core{{/pix}}</a>{{/nexturl}}
            {{^nexturl}}<button type="button" class="fbm-page" disabled aria-label="{{#str}}next, core{{/str}}">{{#pix}}t/right, core{{/pix}}</button>{{/nexturl}}
        </div>
    </div>
</nav>
