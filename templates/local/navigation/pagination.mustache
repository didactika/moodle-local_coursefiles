    @template local_filebank/local/navigation/pagination
    Bounded shared pagination with native controls and preserved search parameters.
    Example context (json): {"id":"mp-page-1","summary":"1–25 / 100","pagelabel":"Page 1 of 4","sizes":[]}
}}
<nav class="filebank-pagination fbm-listbar" aria-label="{{#str}}pagination, local_filebank{{/str}}">
    <div class="fbm-listbar-size">
        <label for="{{id}}" class="fbm-listbar-label">{{#str}}pagesize, local_filebank{{/str}}</label> {{{help}}}
        <select id="{{id}}" class="form-select form-select-sm rounded-pill filebank-page-size" data-filebank-pagesize data-url="{{url}}" data-pageparameter="{{pageparameter}}">
            {{#sizes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/sizes}}
        </select>
    </div>
    <div class="fbm-listbar-pages"><span class="text-muted small" aria-live="polite">{{summary}} · {{pagelabel}}</span>
        <div class="fbm-actions">
            {{#previousurl}}<a href="{{previousurl}}" class="btn btn-link btn-icon" title="{{#str}}previous, core{{/str}}" aria-label="{{#str}}previous, core{{/str}}">{{#pix}}t/left, core{{/pix}}</a>{{/previousurl}}
            {{^previousurl}}<span class="btn btn-link btn-icon disabled" aria-disabled="true" aria-label="{{#str}}previous, core{{/str}}">{{#pix}}t/left, core{{/pix}}</span>{{/previousurl}}
            {{#nexturl}}<a href="{{nexturl}}" class="btn btn-link btn-icon" title="{{#str}}next, core{{/str}}" aria-label="{{#str}}next, core{{/str}}">{{#pix}}t/right, core{{/pix}}</a>{{/nexturl}}
            {{^nexturl}}<span class="btn btn-link btn-icon disabled" aria-disabled="true" aria-label="{{#str}}next, core{{/str}}">{{#pix}}t/right, core{{/pix}}</span>{{/nexturl}}
        </div>
    </div>
</nav>
