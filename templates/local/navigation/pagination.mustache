    @template local_coursefiles/local/navigation/pagination
    Bounded shared pagination with native controls and preserved search parameters.
    Example context (json): {"id":"mp-page-1","summary":"1–25 / 100","pagelabel":"Page 1 of 4","sizes":[]}
}}
<nav class="coursefiles-pagination my-3 d-flex align-items-center justify-content-between flex-wrap" aria-label="{{#str}}pagination, local_coursefiles{{/str}}">
    <div class="d-flex align-items-center coursefiles-actionbar flex-wrap">
        <label for="{{id}}" class="small mb-0">{{#str}}pagesize, local_coursefiles{{/str}} </label> {{{help}}}
        <select id="{{id}}" class="custom-select custom-select-sm coursefiles-page-size" data-coursefiles-pagesize data-url="{{url}}" data-pageparameter="{{pageparameter}}">
            {{#sizes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/sizes}}
        </select>
    </div>
    <div class="coursefiles-actionbar d-flex align-items-center flex-wrap"><span class="small text-muted" aria-live="polite">{{summary}} · {{pagelabel}}</span>
        <div class="btn-group coursefiles-row-actions" role="group" aria-label="{{#str}}pagination, local_coursefiles{{/str}}">
            {{#previousurl}}<a href="{{previousurl}}" class="btn btn-sm btn-outline-secondary" title="{{#str}}previous, core{{/str}}" aria-label="{{#str}}previous, core{{/str}}">{{#pix}}t/left, core{{/pix}}</a>{{/previousurl}}
            {{^previousurl}}<button type="button" class="btn btn-sm btn-outline-secondary" disabled aria-label="{{#str}}previous, core{{/str}}">{{#pix}}t/left, core{{/pix}}</button>{{/previousurl}}
            {{#nexturl}}<a href="{{nexturl}}" class="btn btn-sm btn-outline-secondary" title="{{#str}}next, core{{/str}}" aria-label="{{#str}}next, core{{/str}}">{{#pix}}t/right, core{{/pix}}</a>{{/nexturl}}
            {{^nexturl}}<button type="button" class="btn btn-sm btn-outline-secondary" disabled aria-label="{{#str}}next, core{{/str}}">{{#pix}}t/right, core{{/pix}}</button>{{/nexturl}}
        </div>
    </div>
</nav>
