    @template local_filebank/local/form/rows
    Native editable table enhanced by the row editor.
    Example context (json): {"columns":[{"label":"Capture"}],"add":"Add row"}
}}
<div class="filebank-row-editor">
    <table class="table table-sm"><thead><tr>{{#columns}}<th scope="col">{{label}} {{{help}}}</th>{{/columns}}<th scope="col"><span class="filebank-visually-hidden">{{#str}}actions, core{{/str}}</span></th></tr></thead><tbody></tbody></table>
</div>
<button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-filebank-addrow>{{#pix}}t/add, core{{/pix}}{{add}}</button>
