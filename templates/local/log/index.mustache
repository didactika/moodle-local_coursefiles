    @template local_filebank/local/log/index
    Filtered site action log. Record values are escaped; details are not displayed.
    Example context (json): {"formurl":"/local/filebank/admin/log.php","records":[],"hasrecords":false}
}}
<section class="filebank-ui filebank-admin filebank-log">
    <header class="fbm-header">
        <div class="fbm-header-title">
            <div class="fbm-header-line"><h2 class="fbm-h2">{{#str}}log, local_filebank{{/str}}</h2></div>
            <p class="fbm-muted fbm-header-subtitle">{{#str}}logintro, local_filebank{{/str}}</p>
        </div>
    </header>
    <form method="get" action="{{formurl}}" class="fbm-filters">
        <input type="hidden" name="perpage" value="{{perpage}}">
        <div class="fbm-field">
            <label for="filebank-log-action" class="fbm-label">{{#str}}logaction, local_filebank{{/str}}</label>
            <select id="filebank-log-action" name="action" class="fbm-select fbm-select-fill">
                <option value="">{{#str}}logallactions, local_filebank{{/str}}</option>
                {{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}
            </select>
        </div>
        <div class="fbm-field">
            <label for="filebank-log-reference" class="fbm-label">{{#str}}logreference, local_filebank{{/str}}</label>
            <input id="filebank-log-reference" name="entityuuid" value="{{entityuuid}}" maxlength="36" class="fbm-input">
        </div>
        <div class="fbm-field">
            <label for="filebank-log-from" class="fbm-label">{{#str}}logfrom, local_filebank{{/str}}</label>
            <input id="filebank-log-from" type="date" name="from" value="{{from}}" class="fbm-input">
        </div>
        <div class="fbm-field">
            <label for="filebank-log-until" class="fbm-label">{{#str}}loguntil, local_filebank{{/str}}</label>
            <input id="filebank-log-until" type="date" name="until" value="{{until}}" class="fbm-input">
        </div>
        <div class="fbm-filters-actions">
            <button class="fbm-btn fbm-btn-primary" type="submit">{{#pix}}i/filter, core{{/pix}}{{#str}}filter{{/str}}</button>
            <a class="fbm-btn" href="{{clearurl}}">{{#str}}clear, core{{/str}}</a>
                {{{filterhelp}}}
        </div>
    </form>
    {{#hasrecords}}<div class="fbm-table-wrap"><table class="fbm-table fbm-log-table"><thead><tr><th>{{#str}}date, core{{/str}}</th><th>{{#str}}logaction, local_filebank{{/str}}</th><th>{{#str}}user, core{{/str}}</th><th>{{#str}}logreference, local_filebank{{/str}}</th></tr></thead><tbody>{{#records}}<tr><td class="fbm-nowrap">{{date}}</td><td><span class="fbm-badge fbm-badge-action">{{action}}</span></td><td>{{user}}</td><td class="fbm-small fbm-break fbm-mono">{{reference}}</td></tr>{{/records}}</tbody></table></div>{{/hasrecords}}
    {{^hasrecords}}<div class="fbm-empty"><h4 class="fbm-h4">{{#str}}logempty, local_filebank{{/str}}</h4></div>{{/hasrecords}}
    {{{pagination}}}
</section>
